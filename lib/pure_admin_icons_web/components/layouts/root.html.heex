<!DOCTYPE html>
<html lang="en" data-theme="park-night" data-view-mode="grid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <.live_title
      suffix=" — icons.pureadmin.io"
      default={"icons.pureadmin.io — Search #{catalog_icon_count_display()} Icons from #{catalog_set_count()} Icon Sets"}
    >
      {assigns[:page_title]}
    </.live_title>
    <meta
      property="og:title"
      content={"icons.pureadmin.io — Search #{catalog_icon_count_display()} Icons from #{catalog_set_count()} Icon Sets"}
    />
    <meta
      property="og:description"
      content={"Search icons from #{catalog_set_titles_sentence()}. Platform identifiers for iOS, Android, React, Vue & Svelte. Free API."}
    />
    <meta property="og:url" content="https://icons.pureadmin.io" />
    <meta property="og:site_name" content="icons.pureadmin.io" />
    <meta property="og:type" content="website" />
    <meta
      name="description"
      content={"Search #{catalog_icon_count_display()} open-source SVG icons from #{catalog_set_titles_sentence()}. Platform identifiers for iOS, Android, React, Vue & Svelte."}
    />
    <meta name="keywords" content="icons, SVG, FluentUI, Font Awesome, Heroicons, Lucide, Material, Phosphor, Remix, Tabler, React, Vue, Svelte, iOS, Android, icon search, free icons, open source" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://stats.keenmate.services/js/pa-B3VgdIMAsfLGeFIV2rAdT.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script>
      // FOWT prevention: apply theme before first paint
      (function() {
        var themes = {morning:"park-morning",day:"park-day",evening:"park-evening",night:"park-night"};
        var ov = null;
        try { ov = localStorage.getItem("theme-override"); } catch(e) {}
        if (ov && themes[ov]) {
          document.documentElement.setAttribute("data-theme", themes[ov]);
        } else {
          var h = new Date().getHours();
          var t = h >= 5 && h < 9 ? "park-morning" : h >= 9 && h < 20 ? "park-day" : h >= 20 && h < 22 ? "park-evening" : "park-night";
          document.documentElement.setAttribute("data-theme", t);
        }
        // View mode
        var mode = localStorage.getItem('icon_view_mode') || 'grid';
        document.documentElement.setAttribute('data-view-mode', mode);
      })();
    </script>
    <script defer src={~p"/assets/vendor/floating-ui-core.umd.min.js"}></script>
    <script defer src={~p"/assets/vendor/floating-ui-dom.umd.min.js"}></script>
    <script defer src={~p"/assets/vendor/jszip.min.js"}></script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}></script>
    <style>body { font-family: 'Inter', system-ui, sans-serif; }</style>
  </head>
  <body class="min-h-screen">
    <!-- Page loader — hidden when LiveView connects -->
    <div id="app-loader" class="fixed inset-0 z-[100] flex items-center justify-center bg-base-100 transition-opacity duration-300">
      <div class="flex flex-col items-center gap-3">
        <span class="loading loading-ring loading-lg text-primary"></span>
        <span class="text-sm text-base-content/50">Loading icons...</span>
      </div>
    </div>
    {@inner_content}

    <!-- Floating time-of-day theme switcher (Floating UI positioned) -->
    <div id="theme-switcher" class="fixed bottom-4 right-4 z-50" data-theme-toggle>
      <!-- Expanded panel — position set by Floating UI -->
      <div
        id="theme-sw-panel"
        class="hidden flex flex-col gap-0.5 rounded-lg bg-base-200 border border-base-300 shadow-lg p-1 w-28"
        style="position: fixed; top: 0; left: 0;"
      >
        <button class="theme-sw-btn" data-phx-theme="auto" title="Auto (time-based)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
          </svg>
          <span>Auto</span>
        </button>
        <button class="theme-sw-btn" data-phx-theme="morning" title="Morning (6-11)">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <span>Morning</span>
        </button>
        <button class="theme-sw-btn" data-phx-theme="day" title="Day (11-16)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5.404 4.343a.75.75 0 0 0-1.06 1.06l1.06 1.061a.75.75 0 1 0 1.06-1.06l-1.06-1.06ZM4.25 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 .75.75ZM5.404 15.657a.75.75 0 0 1-1.06 0l-1.06-1.06a.75.75 0 0 1 1.06-1.061l1.06 1.06a.75.75 0 0 1 0 1.06ZM15.657 15.657a.75.75 0 0 1-1.06 0l-1.061-1.06a.75.75 0 1 1 1.06-1.061l1.06 1.06a.75.75 0 0 1 0 1.06Z" />
          </svg>
          <span>Day</span>
        </button>
        <button class="theme-sw-btn" data-phx-theme="evening" title="Evening (16-20)">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
          <span>Evening</span>
        </button>
        <button class="theme-sw-btn" data-phx-theme="night" title="Night (20-6)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z" clip-rule="evenodd" />
          </svg>
          <span>Night</span>
        </button>
      </div>
      <!-- Collapsed trigger (two rows: "Theme" + icon & active theme name) -->
      <button
        id="theme-sw-trigger"
        type="button"
        class="flex flex-col items-center rounded-lg bg-base-200 border border-base-300 shadow-lg py-2 cursor-pointer hover:bg-base-300 transition-colors w-28"
      >
        <span class="text-[10px] text-base-content/50 uppercase tracking-wider">Theme</span>
        <span class="flex items-center gap-1.5">
          <span id="theme-sw-active-icon" class="size-3.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
            </svg>
          </span>
          <span id="theme-sw-active" class="text-xs font-medium text-base-content">Auto</span>
        </span>
      </button>
    </div>
  </body>
</html>
